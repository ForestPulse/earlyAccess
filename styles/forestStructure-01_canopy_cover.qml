<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis version="3.40.11-Bratislava" styleCategories="Symbology">
  <pipe>
    <rasterrenderer type="singlebandpseudocolor" band="1" opacity="1" alphaBand="-1" classificationMin="0" classificationMax="1">
      <rastershader>
        <colorrampshader colorRampType="INTERPOLATED" classificationMode="1" minimumValue="0" maximumValue="1" clip="0">
          <item value="0"   color="#ffffcc" alpha="255" label="0%"/>
          <item value="0.2" color="#ceeba3" alpha="255" label="20%"/>
          <item value="0.4" color="#96d386" alpha="255" label="40%"/>
          <item value="0.6" color="#5cb86a" alpha="255" label="60%"/>
          <item value="0.8" color="#27974e" alpha="255" label="80%"/>
          <item value="1"   color="#006837" alpha="255" label="100%"/>
        </colorrampshader>
      </rastershader>
    </rasterrenderer>
  </pipe>
</qgis>